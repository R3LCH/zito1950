# Copy to .env; never commit .env. Secrets are server-side only (never VITE_*).
APP_ORIGIN=http://localhost:5173
PORT=3001
# Generate with npm run admin:password; paste the full salt:hash value here.
ADMIN_PASSWORD_HASH=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Production: NODE_ENV=production and APP_ORIGIN=https://your-domain.example
# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy, with backend private.
TRUST_PROXY=0
