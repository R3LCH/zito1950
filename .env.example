# Copy to .env; never commit .env. Secrets are server-side only (never VITE_*).
APP_ORIGIN=http://localhost:5173
PORT=3001
# Generate with npm run admin:password; paste the full salt:hash value here.
ADMIN_PASSWORD_HASH=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Production: NODE_ENV=production and APP_ORIGIN=https://your-domain.example
# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy, with backend private.
TRUST_PROXY=0
# Optional: contact email sent to MyMemory for a higher free translation quota (admin auto-translate).
MYMEMORY_EMAIL=
# Order emails over SMTP (nodemailer). Leave SMTP_HOST empty to disable sending: attempts are logged as skipped.
SMTP_HOST=
# 465 with SMTP_SECURE=true (implicit TLS); use 587 with SMTP_SECURE=false for STARTTLS.
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender shown to customers; must be an address the SMTP account may send from.
MAIL_FROM=ZITO 1950® <customer@zito1950.it>
# Receives a copy of every paid order (models, codes, certificate, engraving, shipping).
OWNER_EMAIL=customer@zito1950.it
